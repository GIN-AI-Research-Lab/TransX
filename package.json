{
  "name": "trans-overlay",
  "version": "1.0.0",
  "description": "Real-time audio translation overlay â€” System Audio/Mic â†’ Whisper STT â†’ Local LLM â†’ Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "download-model": "node scripts/download-nllb-model.js",
    "download-model-fast": "node scripts/download-nllb-model.js --model 200M",
    "download-model-fast:auth": "node -e \"if(!process.env.HF_TOKEN){console.error('Thiếu HF_TOKEN!\\nCách lấy token:\\n  1. Đăng ký tại https://huggingface.co\\n  2. Vào https://huggingface.co/settings/tokens\\n  3. Tạo token (Read)\\n  4. Đặt: $env:HF_TOKEN=\\\"hf_xxx...\\\" rồi chạy lại lệnh này');process.exit(1)}\" && node scripts/download-nllb-model.js --model 200M",
    "setup:python": "node scripts/setup-python-embed.js",
    "setup:ct2": "python-embed\\python.exe -X utf8 scripts\\setup-nllb-ct2.py",
    "setup:all": "npm run setup:python && npm run setup:ct2",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable",
    "postinstall": "electron-rebuild"
  },
  "build": {
    "appId": "com.trans.overlay",
    "productName": "Trans Overlay",
    "copyright": "Copyright © 2026 Trans Overlay",
    "win": {
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "asInvoker"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "renderer/**",
      "src/**",
      "node_modules/**",
      "!node_modules/.cache",
      "!**/*.md",
      "!**/*.ps1",
      "!scripts/**",
      "!whisper-bin/**",
      "!whisper-models/**",
      "!nllb-models/**"
    ],
    "extraResources": [
      { "from": "whisper-bin",        "to": "whisper-bin"         },
      { "from": "whisper-models",     "to": "whisper-models",
        "filter": ["ggml-base.bin"] },
      { "from": "nllb-ct2-server.py", "to": "nllb-ct2-server.py"  },
      { "from": "nllb-ct2-model",     "to": "nllb-ct2-model"      },
      { "from": "python-embed",       "to": "python-embed"        }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Trans Overlay",
      "deleteAppDataOnUninstall": false
    },
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-web/dist/*.wasm",
      "node_modules/@xenova/transformers/dist/*.wasm"
    ]
  },
  "author": "Trans Overlay",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "overrides": {
    "sharp": "file:./scripts/sharp-stub"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^28.3.0",
    "electron-builder": "^24.9.4"
  }
}
